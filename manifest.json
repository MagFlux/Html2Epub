{
  "manifest_version": 3,
  "name": "Html2Epub",
  "version": "0.1.0",
  "description": "Extract the readable article from the current page for EPUB conversion.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
